+            "submit",
+            "gpu_wait",
+            "pipeline_create",
+            "shape_prepare",
+            "cache_draws",
+            "main_draw",
+        ];
+
+        static MICROS: [AtomicU64; LEN] = [const { AtomicU64::new(0) }; LEN];
+
+        #[inline]
+        pub fn time<R>(timer: usize, f: impl FnOnce() -> R) -> R {
+            let start = std::time::Instant::now();
+            let result = f();
+            MICROS[timer].fetch_add(start.elapsed().as_micros() as u64, Ordering::Relaxed);
+            result
+        }
