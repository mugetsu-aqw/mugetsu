+fn atlas_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("RUFFLE_NO_ATLAS").is_none())
+        && crate::ATLAS_ENABLED.load(std::sync::atomic::Ordering::Relaxed)
+}
